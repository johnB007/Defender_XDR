// IOC Quick Lookup - All Types in One Place
// Paste your IOCs into the let statements below using ctrl + A + Run Query
// The query searches across all tables and returns normalized results

let FileHashes = dynamic(["c22fd9b8fd45d81563971929fce22619f1a7cfe6" // Put any File Hash here with ""
]);

let Domains = dynamic([ // Put any Domain here with ""
]);

let URLs = dynamic([ // Put any URL here here with ""
]);

let IPs = dynamic(["52.123.251.60"// Put any IP here here with ""
]);

let EmailAddresses = dynamic([ // Put any email here here with ""
]);

let FileHashHits = DeviceFileEvents
| where SHA1 in (FileHashes) or MD5 in (FileHashes) or SHA256 in (FileHashes)
| extend IOCType = "FileHash", IOCValue = coalesce(SHA1, MD5, SHA256), Source = "DeviceFileEvents"
| project TimeGenerated, IOCType, IOCValue, Source, DeviceName, FileName, FolderPath, ActionType;

let DomainNetworkHits = DeviceNetworkEvents
| where RemoteUrl has_any (Domains) or RemoteIP in (Domains)
| extend IOCType = "Domain", IOCValue = coalesce(RemoteUrl, RemoteIP), Source = "DeviceNetworkEvents"
| project TimeGenerated, IOCType, IOCValue, Source, DeviceName, ActionType, RemoteUrl, RemoteIP, RemotePort;

let URLNetworkHits = DeviceNetworkEvents
| where RemoteUrl has_any (URLs)
| extend IOCType = "URL", IOCValue = RemoteUrl, Source = "DeviceNetworkEvents"
| project TimeGenerated, IOCType, IOCValue, Source, DeviceName, ActionType, RemoteUrl, RemotePort;

let IPNetworkHits = DeviceNetworkEvents
| where RemoteIP in (IPs)
| extend IOCType = "IP", IOCValue = RemoteIP, Source = "DeviceNetworkEvents"
| project TimeGenerated, IOCType, IOCValue, Source, DeviceName, ActionType, RemoteIP, RemotePort, RemoteUrl;

let DomainEmailHits = EmailEvents
| where RecipientEmailAddress has_any (Domains) or SenderFromAddress has_any (Domains)
| extend IOCType = "Domain", IOCValue = coalesce(SenderFromAddress, RecipientEmailAddress), Source = "EmailEvents"
| project TimeGenerated, IOCType, IOCValue, Source, SenderFromAddress, RecipientEmailAddress, Subject, ThreatTypes;

let URLEmailHits = EmailEvents
| where Subject has_any (URLs)
| extend IOCType = "URL", IOCValue = Subject, Source = "EmailEvents"
| project TimeGenerated, IOCType, IOCValue, Source, SenderFromAddress, RecipientEmailAddress, Subject, ThreatTypes;

let EmailAddressHits = EmailEvents
| where RecipientEmailAddress in (EmailAddresses) or SenderFromAddress in (EmailAddresses)
| extend IOCType = "EmailAddress", IOCValue = coalesce(SenderFromAddress, RecipientEmailAddress), Source = "EmailEvents"
| project TimeGenerated, IOCType, IOCValue, Source, SenderFromAddress, RecipientEmailAddress, Subject, ThreatTypes, DeliveryAction;

// Union all results and display
union FileHashHits, DomainNetworkHits, URLNetworkHits, IPNetworkHits, DomainEmailHits, URLEmailHits, EmailAddressHits
| sort by TimeGenerated desc
