// Title: AV Status and EDR Running Mode - Windows, macOS, Linux
// Author: John Barbare
// Tables: DeviceTvmSecureConfigurationAssessment, DeviceTvmInfoGathering
// MITRE: N/A
// Time window: current (TVM tables have no Timestamp filter)
// Notes:
//   AvMode source: DeviceTvmInfoGathering.AdditionalFields.AvMode
//   These integers have NO public Microsoft documentation.
//   The WMI class (MSFT_MpComputerStatus, ProtectionManagement.mof) defines
//   AMRunningMode as a plain string with no ValueMap - so the integers do NOT
//   come from WMI. They are written by the MDE internal telemetry sensor
//   (MpClient.dll / Sense service) directly into the TVM pipeline before any
//   string conversion. The string equivalents from Get-MpComputerStatus are:
//     0 = "Normal"         -> Active (MDE AV is primary, full protect + block)
//     1 = "Passive"        -> Passive (another AV primary, MDE detects only)
//     2 = "Disabled"       -> AV protection is disabled
//     4 = "EDR Block Mode" -> AV passive, EDR component still actively blocks
//   Confirmed via: MOF inspection + community Advanced Hunting queries.
//   AV version/sig details source: DeviceTvmSecureConfigurationAssessment
//     Windows scid-2011 | macOS scid-5095 | Linux scid-6095
//   Validation note: Both tables live in the M365 Defender Advanced Hunting
//   plane, not in Sentinel Log Analytics. Validate in the M365 Defender portal.

// ── Step 1: AVMode lookup (onboarded devices only - TVM source) ──────────────
let AvModeMap =
    DeviceTvmInfoGathering
    | extend AvModeRaw = tostring(AdditionalFields.AvMode)
    | where isnotnull(AvModeRaw)
    | extend AVMode = case(
        AvModeRaw == "0", "Active",
        AvModeRaw == "1", "Passive",
        AvModeRaw == "2", "Disabled",
        AvModeRaw == "4", "EDR Block Mode",
        strcat("Unknown (", AvModeRaw, ")")
      )
    | project DeviceId, AVMode;
// ── Step 2: AV version details (onboarded devices only - TVM source) ─────────
let AvDetails =
    DeviceTvmSecureConfigurationAssessment
    | where isnotnull(Context)
    | where (ConfigurationId == "scid-2011" and OSPlatform startswith "Windows")
        or  (ConfigurationId == "scid-5095" and OSPlatform == "macOS")
        or  (ConfigurationId == "scid-6095" and OSPlatform == "Linux")
    | extend avdata            = parsejson(Context)
    | extend AVSigVersion        = tostring(avdata[0][0])
    | extend AVEngineVersion     = tostring(avdata[0][1])
    | extend AVSigLastUpdateTime = tostring(avdata[0][2])
    | extend AVProductVersion    = tostring(avdata[0][3])
    | project DeviceId,
        AVSigVersion, AVEngineVersion, AVSigLastUpdateTime, AVProductVersion,
        IsCompliant, IsApplicable;
// ── Step 3: ALL devices from DeviceInfo as the anchor ────────────────────────
// DeviceInfo includes onboarded, discovered, and partially managed devices.
// Non-onboarded devices will appear with null AV details and AVMode.
DeviceInfo
| where isnotempty(DeviceName)
| summarize arg_max(Timestamp, *) by DeviceId
| where OSPlatform startswith "Windows"
    or OSPlatform == "macOS"
    or OSPlatform == "Linux"
| project DeviceId, DeviceName, OSPlatform, OnboardingStatus
// ── Step 4: Join AV details and AVMode as optional enrichment ─────────────────
| join kind=leftouter AvDetails on DeviceId
| join kind=leftouter AvModeMap on DeviceId
| project DeviceId, DeviceName, OSPlatform, OnboardingStatus,
    AVSigVersion, AVEngineVersion, AVSigLastUpdateTime, AVProductVersion,
    AVMode, IsCompliant, IsApplicable
| order by OSPlatform asc, DeviceName asc
