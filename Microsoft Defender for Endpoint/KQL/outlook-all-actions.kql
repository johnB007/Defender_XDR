// Title: Outlook broad activity timeline
// Author: John Barbare
// Tables: DeviceProcessEvents, DeviceNetworkEvents, DeviceFileEvents, DeviceRegistryEvents, DeviceImageLoadEvents
// MITRE: T1071, T1083, T1112
// Time window: last 24h
// Notes: This is a broad endpoint activity view for Outlook.exe on device telemetry. It does not include every Outlook UI click event.

union (DeviceProcessEvents | where Timestamp > ago(24h) | where FileName =~ "outlook.exe" | project Timestamp, DeviceName, EventTable = "DeviceProcessEvents", ActionType, ProcessName = FileName, ProcessCommandLine, Entity = strcat(FolderPath, "\\", FileName), RemoteUrl = "", ReportId), (DeviceNetworkEvents | where Timestamp > ago(24h) | where InitiatingProcessFileName =~ "outlook.exe" | project Timestamp, DeviceName, EventTable = "DeviceNetworkEvents", ActionType, ProcessName = InitiatingProcessFileName, ProcessCommandLine = InitiatingProcessCommandLine, Entity = strcat(RemoteIP, ":", tostring(RemotePort)), RemoteUrl, ReportId), (DeviceFileEvents | where Timestamp > ago(24h) | where InitiatingProcessFileName =~ "outlook.exe" | project Timestamp, DeviceName, EventTable = "DeviceFileEvents", ActionType, ProcessName = InitiatingProcessFileName, ProcessCommandLine = InitiatingProcessCommandLine, Entity = strcat(FolderPath, "\\", FileName), RemoteUrl = "", ReportId), (DeviceRegistryEvents | where Timestamp > ago(24h) | where InitiatingProcessFileName =~ "outlook.exe" | project Timestamp, DeviceName, EventTable = "DeviceRegistryEvents", ActionType, ProcessName = InitiatingProcessFileName, ProcessCommandLine = InitiatingProcessCommandLine, Entity = RegistryKey, RemoteUrl = "", ReportId), (DeviceImageLoadEvents | where Timestamp > ago(24h) | where InitiatingProcessFileName =~ "outlook.exe" | project Timestamp, DeviceName, EventTable = "DeviceImageLoadEvents", ActionType, ProcessName = InitiatingProcessFileName, ProcessCommandLine = InitiatingProcessCommandLine, Entity = strcat(FolderPath, "\\", FileName), RemoteUrl = "", ReportId)
| order by Timestamp desc