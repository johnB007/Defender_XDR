{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflowName": {
      "type": "string",
      "defaultValue": "AirGap-Device-Remediation"
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus"
    },
    "sentinelConnectionName": {
      "type": "string",
      "defaultValue": "azuresentinel"
    },
    "monitorLogsConnectionName": {
      "type": "string",
      "defaultValue": "azuremonitorlogs"
    },
    "office365ConnectionName": {
      "type": "string",
      "defaultValue": "office365"
    },
    "graphEndpoint": {
      "type": "string",
      "defaultValue": "https://graph.microsoft.com/v1.0/security/runHuntingQuery"
    },
    "graphAudience": {
      "type": "string",
      "defaultValue": "https://graph.microsoft.com"
    },
    "mdeApiHost": {
      "type": "string",
      "defaultValue": "https://api.securitycenter.microsoft.com"
    },
    "mdeAudience": {
      "type": "string",
      "defaultValue": "https://api.securitycenter.microsoft.com"
    },
    "lawSubscriptionId": {
      "type": "string",
      "defaultValue": ""
    },
    "lawResourceGroup": {
      "type": "string",
      "defaultValue": ""
    },
    "lawWorkspaceName": {
      "type": "string",
      "defaultValue": ""
    },
    "watchlistAlias": {
      "type": "string",
      "defaultValue": "AirGapContacts"
    },
    "enableIsolation": {
      "type": "bool",
      "defaultValue": false
    }
  },
  "variables": {
    "sentinelConnName": "[parameters('sentinelConnectionName')]",
    "monitorlogsConnName": "[parameters('monitorLogsConnectionName')]",
    "office365ConnName": "[parameters('office365ConnectionName')]",
    "sentinelApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]",
    "monitorlogsApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuremonitorlogs')]",
    "office365ApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]",
    "sentinelConnId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnName'))]",
    "monitorlogsConnId": "[resourceId('Microsoft.Web/connections', variables('monitorlogsConnName'))]",
    "office365ConnId": "[resourceId('Microsoft.Web/connections', variables('office365ConnName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('sentinelConnName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[variables('sentinelApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('monitorlogsConnName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('monitorlogsConnName')]",
        "api": {
          "id": "[variables('monitorlogsApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('office365ConnName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('office365ConnName')]",
        "api": {
          "id": "[variables('office365ApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[variables('sentinelConnId')]",
        "[variables('monitorlogsConnId')]",
        "[variables('office365ConnId')]"
      ],
      "properties": {
        "state": "Disabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Filter_Host_Entities": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(triggerBody()?['object']?['properties']?['relatedEntities'], json('[]'))",
                "where": "@equals(toLower(item()?['kind']), 'host')"
              },
              "runAfter": {}
            },
            "Filter_IP_Entities": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(triggerBody()?['object']?['properties']?['relatedEntities'], json('[]'))",
                "where": "@equals(toLower(item()?['kind']), 'ip')"
              },
              "runAfter": {
                "Filter_Host_Entities": [
                  "Succeeded"
                ]
              }
            },
            "Init_OffenderName": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "OffenderName",
                    "type": "string",
                    "value": "@{coalesce(first(body('Filter_Host_Entities'))?['properties']?['hostName'], first(body('Filter_Host_Entities'))?['properties']?['netBiosName'], '')}"
                  }
                ]
              },
              "runAfter": {
                "Filter_IP_Entities": [
                  "Succeeded"
                ]
              }
            },
            "Init_OffenderIp": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "OffenderIp",
                    "type": "string",
                    "value": "@{coalesce(first(body('Filter_IP_Entities'))?['properties']?['address'], '')}"
                  }
                ]
              },
              "runAfter": {
                "Init_OffenderName": [
                  "Succeeded"
                ]
              }
            },
            "Build_Offender_Id_Query": {
              "type": "Compose",
              "inputs": "DeviceInfo\n| where Timestamp > ago(30d)\n| where DeviceName =~ \"@{variables('OffenderName')}\"\n| summarize arg_max(Timestamp, *) by DeviceId\n| top 1 by Timestamp desc\n| project DeviceId, DeviceName",
              "runAfter": {
                "Init_OffenderIp": [
                  "Succeeded"
                ]
              }
            },
            "Run_Offender_Id_Hunt": {
              "type": "Http",
              "inputs": {
                "uri": "@{parameters('GraphEndpoint')}",
                "method": "POST",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "Query": "@outputs('Build_Offender_Id_Query')"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "@{parameters('GraphAudience')}"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Build_Offender_Id_Query": [
                  "Succeeded"
                ]
              }
            },
            "Init_OffenderMachineId": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "OffenderMachineId",
                    "type": "string",
                    "value": "@{coalesce(first(body('Run_Offender_Id_Hunt')?['results'])?['DeviceId'], '')}"
                  }
                ]
              },
              "runAfter": {
                "Run_Offender_Id_Hunt": [
                  "Succeeded"
                ]
              }
            },
            "Gate_Isolation": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@parameters('EnableIsolation')",
                      true
                    ]
                  },
                  {
                    "not": {
                      "equals": [
                        "@variables('OffenderMachineId')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Contain_Device": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@{parameters('MdeApiHost')}/api/machines/@{variables('OffenderMachineId')}/isolate",
                    "method": "POST",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "Comment": "@{concat('Air gapped device found on the non air gapped network. Contained by automation for Sentinel incident ', string(triggerBody()?['object']?['properties']?['incidentNumber']))}",
                      "IsolationType": "@parameters('IsolationType')"
                    },
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "@{parameters('MdeAudience')}"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  },
                  "runAfter": {}
                }
              },
              "runAfter": {
                "Init_OffenderMachineId": [
                  "Succeeded"
                ]
              }
            },
            "Build_Discoverer_Query": {
              "type": "Compose",
              "inputs": "DeviceNetworkEvents\n| where Timestamp > ago(7d)\n| where RemoteIP == \"@{variables('OffenderIp')}\"\n| summarize LastSeen = max(Timestamp) by DiscovererDevice = DeviceName, DiscovererDeviceId = DeviceId\n| top 1 by LastSeen desc\n| project DiscovererDevice, DiscovererDeviceId",
              "runAfter": {
                "Gate_Isolation": [
                  "Succeeded"
                ]
              }
            },
            "Run_Discoverer_Hunt": {
              "type": "Http",
              "inputs": {
                "uri": "@{parameters('GraphEndpoint')}",
                "method": "POST",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "Query": "@outputs('Build_Discoverer_Query')"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "@{parameters('GraphAudience')}"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Build_Discoverer_Query": [
                  "Succeeded"
                ]
              }
            },
            "Init_DiscovererDevice": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "DiscovererDevice",
                    "type": "string",
                    "value": "@{coalesce(first(body('Run_Discoverer_Hunt')?['results'])?['DiscovererDevice'], 'Not identified')}"
                  }
                ]
              },
              "runAfter": {
                "Run_Discoverer_Hunt": [
                  "Succeeded"
                ]
              }
            },
            "Compose_Prefix": {
              "type": "Compose",
              "inputs": "@if(greater(length(variables('OffenderName')), 3), toLower(substring(variables('OffenderName'), 0, 4)), toLower(variables('OffenderName')))",
              "runAfter": {
                "Init_DiscovererDevice": [
                  "Succeeded"
                ]
              }
            },
            "Watchlist_Lookup": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "query": "@{concat('_GetWatchlist(\"', parameters('WatchlistAlias'), '\") | where tolower(Prefix) == \"', outputs('Compose_Prefix'), '\" | project Prefix, ITSmtp | take 1')}"
                },
                "path": "/queryDataV2",
                "queries": {
                  "subscriptions": "@parameters('LawSubscriptionId')",
                  "resourcegroups": "@parameters('LawResourceGroup')",
                  "resourcetype": "Log Analytics Workspace",
                  "resourcename": "@parameters('LawWorkspaceName')",
                  "timerange": "Last 7 days"
                }
              },
              "runAfter": {
                "Compose_Prefix": [
                  "Succeeded"
                ]
              }
            },
            "Init_ITSmtp": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "ITSmtp",
                    "type": "string",
                    "value": "@{first(body('Watchlist_Lookup')?['value'])?['ITSmtp']}"
                  }
                ]
              },
              "runAfter": {
                "Watchlist_Lookup": [
                  "Succeeded"
                ]
              }
            },
            "Add_Incident_Comment": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "message": "@{concat('<p>Air gapped device remediation automation</p><ul><li>Offending device: ', variables('OffenderName'), '</li><li>Containment status: ', if(and(equals(parameters('EnableIsolation'), true), not(empty(variables('OffenderMachineId')))), 'MDE isolation action succeeded (UnManagedDevice); automatic release is expected after 7 days.', 'MDE isolation was NOT performed: isolation is disabled or no Defender device ID was resolved.'), '</li><li>Discovered by device: ', variables('DiscovererDevice'), '</li><li>Notification recipient: ', variables('ITSmtp'), '</li></ul>')}"
                },
                "path": "/Incidents/Comment"
              },
              "runAfter": {
                "Init_ITSmtp": [
                  "Succeeded"
                ]
              }
            },
            "Send_Email": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "To": "@variables('ITSmtp')",
                  "Subject": "@{concat('Action required: air gapped device on the network - ', variables('OffenderName'))}",
                  "Body": "@{concat('<p>An air gapped device was found on the network.</p><ul><li>Offending device: ', variables('OffenderName'), '</li><li>Containment status: ', if(and(equals(parameters('EnableIsolation'), true), not(empty(variables('OffenderMachineId')))), 'MDE isolation action succeeded (UnManagedDevice); automatic release is expected after 7 days.', 'MDE isolation was NOT performed: isolation is disabled or no Defender device ID was resolved.'), '</li><li>Discovered by device: ', variables('DiscovererDevice'), '</li><li>Sentinel incident: ', string(triggerBody()?['object']?['properties']?['incidentNumber']), '</li></ul><p>Follow local procedures to investigate and remove the device from the network.</p>')}",
                  "Importance": "High"
                },
                "path": "/v2/Mail"
              },
              "runAfter": {
                "Add_Incident_Comment": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {},
          "parameters": {
            "MdeApiHost": {
              "type": "String",
              "defaultValue": "[parameters('mdeApiHost')]"
            },
            "IsolationType": {
              "type": "String",
              "defaultValue": "UnManagedDevice"
            },
            "EnableIsolation": {
              "type": "Bool",
              "defaultValue": "[parameters('enableIsolation')]"
            },
            "WatchlistAlias": {
              "type": "String",
              "defaultValue": "[parameters('watchlistAlias')]"
            },
            "LawSubscriptionId": {
              "type": "String",
              "defaultValue": "[parameters('lawSubscriptionId')]"
            },
            "LawResourceGroup": {
              "type": "String",
              "defaultValue": "[parameters('lawResourceGroup')]"
            },
            "LawWorkspaceName": {
              "type": "String",
              "defaultValue": "[parameters('lawWorkspaceName')]"
            },
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "GraphEndpoint": {
              "type": "String",
              "defaultValue": "[parameters('graphEndpoint')]"
            },
            "GraphAudience": {
              "type": "String",
              "defaultValue": "[parameters('graphAudience')]"
            },
            "MdeAudience": {
              "type": "String",
              "defaultValue": "[parameters('mdeAudience')]"
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[variables('sentinelApiId')]",
                "connectionId": "[variables('sentinelConnId')]",
                "connectionName": "[variables('sentinelConnName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "azuremonitorlogs": {
                "id": "[variables('monitorlogsApiId')]",
                "connectionId": "[variables('monitorlogsConnId')]",
                "connectionName": "[variables('monitorlogsConnName')]"
              },
              "office365": {
                "id": "[variables('office365ApiId')]",
                "connectionId": "[variables('office365ConnId')]",
                "connectionName": "[variables('office365ConnName')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "workflowResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('workflowName'))]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('workflowName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
