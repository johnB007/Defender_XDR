// Hunt: ClickFix RunMRU registry indicator (Run dialog abuse)
// Table: DeviceRegistryEvents
// Source: adapted from Microsoft Threat Intelligence, "Think before you
//         Click(Fix): Analyzing the ClickFix social engineering technique",
//         Microsoft Security Blog, August 21 2025.
// Purpose: ClickFix lures trick a user into pasting a command into the
//          Windows Run dialog (Win+R). Every Run dialog execution leaves a
//          forensic trace in the RunMRU registry key under
//          Explorer\RunMRU, written by explorer.exe. This hunt flags RunMRU
//          entries that reference a living off the land binary (powershell,
//          mshta, curl, msiexec, bitsadmin, forfiles, wscript, cscript,
//          rundll32, cmd) or use caret escape obfuscation, both hallmarks of
//          a ClickFix payload rather than an everyday Run dialog command.
// Validated: success (query mechanics confirmed, DeviceRegistryEvents has
//          live data for explorer.exe in this tenant), 0 rows in the live
//          7 day window. No RunMRU registry writes were observed at all in
//          this tenant over a 30 day lookback, so a 0 row result here most
//          likely reflects the registry auditing scope of this environment
//          rather than an absence of Run dialog usage. Re-check auditing
//          coverage for this key before relying on this hunt alone.
DeviceRegistryEvents
| where Timestamp > ago(7d)
| where ActionType =~ 'RegistryValueSet'
| where InitiatingProcessFileName =~ 'explorer.exe'
| where RegistryKey has @'\CurrentVersion\Explorer\RunMRU'
| where RegistryValueName !~ 'MRUList'
| where RegistryValueData has_any ('powershell', 'mshta', 'curl', 'msiexec', 'bitsadmin', 'forfiles', 'wscript', 'cscript', 'rundll32', 'cmd')
    or RegistryValueData has '^'
| project Timestamp, DeviceName, InitiatingProcessAccountName, RegistryValueName, RegistryValueData
| order by Timestamp desc
| take 10000
